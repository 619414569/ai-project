# 镜像版本标签（本地构建用 local，发布用语义化版本，例如 1.1.0）
APP_VERSION=local

# 端口与绑定地址
# 619414569应用 已占用 80（前端）和 8080（后端），本应用不能复用这两个宿主机端口
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=81
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081

# 共享 Docker 网络：由 619414569应用 的 compose 创建（项目名 ai-scaffold + 网络键 ai-network）
# 用 docker network ls 核对实际名称后再修改，不要写成 ai-scaffold_default
SHARED_NETWORK_NAME=ai-scaffold_ai-network

# 数据库：共享 PostgreSQL 实例中为本应用单独创建的库与角色
# 建库脚本见 数据/初始化/01_create_database_shared_instance.sql
DB_URL=jdbc:postgresql://postgres:5432/ai_scaffold_chendu
DB_USERNAME=ai_scaffold_chendu
DB_PASSWORD=change-me-db
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10

# Redis：复用 619414569应用 的 redis 容器，口令必须与其 REDIS_PASSWORD 完全一致
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# RocketMQ：复用 619414569应用 的 name server；消费组独立，避免与其争抢同一队列
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_PRODUCER_GROUP=ai-scaffold-chendu-producer
ROCKETMQ_CONSUMER_GROUP=ai-scaffold-chendu-consumer
ROCKETMQ_DEMO_TOPIC=ai-scaffold-demo
ROCKETMQ_ENABLED=true

# 应用安全：JWT_SECRET 至少 32 位随机字符，正式环境用 64 位随机值
JWT_SECRET=replace-this-development-secret-with-a-random-64-character-value
JWT_ISSUER=ai-scaffold
JWT_ACCESS_TOKEN_TTL=PT2H
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_ADMIN_ROLES=ADMIN,USER
DEMO_DCY_USERNAME=dcy
DEMO_DCY_PASSWORD=admin123
DEMO_DCY_ROLES=USER
APP_DEMO_DATA_ENABLED=true

# 浏览器来源白名单：只保留正式访问入口
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:81,http://127.0.0.1,http://127.0.0.1:81
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.1[6-9].*:*,http://172.2[0-9].*:*,http://172.3[01].*:*

# 前端 Nginx 反向代理目标（容器内地址）
BACKEND_URL=http://backend:8080
