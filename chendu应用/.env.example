# Web and service ports
WEB_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911

# PostgreSQL (local stand-in for PolarDB-PG)
POSTGRES_DB=ai_scaffold
POSTGRES_USER=ai_scaffold
POSTGRES_PASSWORD=change-me-postgres

# Standalone backend container (Compose overrides these with service names)
DB_URL=jdbc:postgresql://host.docker.internal:5432/ai_scaffold
DB_USERNAME=ai_scaffold
DB_PASSWORD=change-me-postgres

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_HOST=host.docker.internal
ROCKETMQ_NAME_SERVER=host.docker.internal:9876

# Application security - use at least 32 random characters outside local development
JWT_SECRET=replace-this-development-secret-with-a-random-64-character-value
JWT_ACCESS_TOKEN_TTL=PT2H
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_DCY_USERNAME=dcy
DEMO_DCY_PASSWORD=admin123
DEMO_DCY_ROLES=USER
APP_DEMO_DATA_ENABLED=true

# Browser origins allowed to call the backend directly
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.1[6-9].*:*,http://172.2[0-9].*:*,http://172.3[01].*:*

# Standalone frontend container
BACKEND_URL=http://host.docker.internal:8080
