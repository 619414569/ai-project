# Image version and bind addresses
APP_VERSION=1.0.0
WEB_BIND_ADDRESS=0.0.0.0
SERVICE_BIND_ADDRESS=127.0.0.1

# Web and service ports
WEB_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_HOST_PORT=6379
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911

# PostgreSQL (local stand-in for PolarDB-PG)
POSTGRES_DB=ai_scaffold
POSTGRES_USER=ai_scaffold
POSTGRES_PASSWORD=change-me-postgres

# Backend service connections inside the Compose network
DB_URL=jdbc:postgresql://postgres:5432/ai_scaffold
DB_USERNAME=ai_scaffold
DB_PASSWORD=change-me-postgres

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_HOST=redis
REDIS_PORT=6379
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876

# Application security - use at least 32 random characters outside local development
JWT_SECRET=replace-this-development-secret-with-a-random-64-character-value
JWT_ACCESS_TOKEN_TTL=PT2H
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
APP_DEMO_DATA_ENABLED=true

# Browser origin patterns allowed to call the backend directly
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:[*],http://127.0.0.1,http://127.0.0.1:[*]

# Frontend reverse proxy target inside the Compose network
BACKEND_URL=http://backend:8080
